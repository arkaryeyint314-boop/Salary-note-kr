:root{
  --bg:#09090F;
  --card:#131722;
  --purple:#7C3AED;
  --blue:#2563EB;
  --green:#22C55E;
  --text:#F8FAFC;
  --muted:#94A3B8;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  background:var(--bg);
  color:var(--text);
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display",sans-serif;
}